HOST=127.0.0.1
PORT=3000
DATA_FILE=./data/rollpilot.json
MONGODB_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional alternate provider: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Persistent photo index: cheap model first, at most four ambiguous images escalated per batch.
GEMINI_INDEX_MODEL=gemini-3.5-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.5-flash
