HOST=127.0.0.1
PORT=3000
DATA_FILE=./data/rollpilot.json
MONGODB_URI=
GEMINI_API_KEY=
# Paid provider calls are disabled unless explicitly re-enabled server-side.
CLOUD_AI_ENABLED=false
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional alternate provider: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Photo/image and query embeddings always use gemini-embedding-2, 768 dimensions.
# GEMINI_MODEL and GEMINI_FALLBACK_MODEL affect only bounded reasoning.
